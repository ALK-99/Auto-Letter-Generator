{
  "name": "surat-otomatis",
  "version": "1.0.0",
  "description": "Surat Otomatis: pembuat surat resmi (PC dan Android)",
  "author": "Surat Otomatis",
  "main": "main.js",
  "scripts": {
    "postinstall": "node copy-libs.js",
    "start": "electron .",
    "build:pc": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1"
  },
  "build": {
    "appId": "com.pribadi.suratotomatis",
    "productName": "Surat Otomatis",
    "compression": "maximum",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "www/**/*"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": true, "artifactName": "Surat-Otomatis-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Surat-Otomatis-Portable-${version}.${ext}" }
  }
}
